              "raw": "{\n  \"fullName\": \"Demo Staff\",\n  \"email\": \"demo.staff@manorhotel.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"RECEPTION\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Update staff role/status",
