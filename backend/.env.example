PORT=5000
DATABASE_URL=postgresql://manor_crm:manor_crm_dev_pw@localhost:5432/manor_crm?schema=public
# Same as DATABASE_URL for local/Docker Postgres. On Neon, DATABASE_URL is the pooled
# (PgBouncer) connection string and DIRECT_URL is the unpooled one (used by Prisma Migrate).
DIRECT_URL=postgresql://manor_crm:manor_crm_dev_pw@localhost:5432/manor_crm?schema=public
JWT_SECRET=change_this_for_production
CORS_ORIGIN=http://localhost:5173
